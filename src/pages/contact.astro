---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Rashmi Dangol" description="Thank you for looking through my portfolio. Please reach out with any questions or comments!">
  <main class="min-h-[75vh] px-6 py-20 md:px-12">
    <section class="mx-auto max-w-5xl">
      <div class="max-w-2xl reveal">
        <p class="mb-4 font-mono text-sm uppercase tracking-[0.2em] text-primary">Let's connect</p>
        <h1 class="mb-6 text-5xl font-black leading-tight md:text-7xl">Contact</h1>
        <p class="text-lg leading-relaxed opacity-80 md:text-xl">
          Thank you for looking through my portfolio. Please reach out with any questions or comments!
          
        </p>
      </div>
      <p class="mt-8 text-lg font-medium">
        Email: <span class="text-primary">dangolrashmi012@gmail.com</span>
      </p>
      <div class="mt-14 max-w-xl">
        <a
          href="https://www.linkedin.com/in/rashmi-dangol/"
          target="_blank"
          rel="noopener noreferrer"
          class="group card border border-base-300 bg-base-200 shadow-xl transition-transform duration-300 hover:-translate-y-1 hover:border-primary"
        >
          <div class="card-body">
            <div class="mb-5 flex items-center justify-between">
              <span class="text-3xl font-black text-primary" aria-hidden="true">in</span>
              <span class="text-xl transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">↗</span>
            </div>
            <h2 class="card-title text-2xl">LinkedIn</h2>
            <p class="opacity-70">Connect with me professionally and follow my work.</p>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout>
