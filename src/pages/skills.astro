---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Skills | Rashmi Dangol">
  <main class="max-w-5xl mx-auto py-20 px-6">
    <h1 class="text-5xl font-black mb-8 reveal">My <span class="text-primary">Skills</span></h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="card bg-base-200 p-8 reveal" style="transition-delay: 200ms;">
        <h2 class="text-2xl font-bold mb-4">Technical Skills</h2>
        <div class="flex flex-wrap gap-2">
          {['GIS', 'Remote Sensing', 'UAV Mapping', 'ArcGIS Pro', 'QGIS', 'ArcGIS Online', 'ArcGIS Dashboards', 'ArcPy', 'Python', 'Machine Learning', 'Computer Vision', 'Data Visualization', 'Spatial Analysis'].map(skill => (
            <div class="badge badge-primary badge-lg p-4">{skill}</div>
          ))}
        </div>
      </div>

      <div class="card bg-base-200 p-8 reveal" style="transition-delay: 400ms;">
        <h2 class="text-2xl font-bold mb-4">Tools & Platforms</h2>
        <div class="flex flex-wrap gap-2">
          {['Pix4DMapper', 'ArcGIS Experience Builder', 'ArcGIS Dashboard', 'ArcGIS Survey123', 'StoryMaps', 'SAS', 'Google Earth Engine', 'Python Notebooks', 'Excel', 'Power BI'].map(tool => (
            <div class="badge badge-secondary badge-lg p-4">{tool}</div>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>
