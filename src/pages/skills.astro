---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Skills | Rashmi Dangol">
  <main class="max-w-5xl mx-auto py-20 px-6">
    <h1 class="text-5xl font-black mb-8 reveal">My <span class="text-primary">Skills</span></h1>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {[
        {
          title: 'Esri Product Suite',
          skills: ['ArcGIS Pro', 'ArcMap','ArcGIS Online', 'ArcGIS Dashboards', 'ArcGIS Experience Builder', 'ArcGIS Survey123', 'StoryMaps', 'ArcPy'],
          badge: 'badge-secondary',
        },
        {
          title: 'Remote Sensing and UAV',
          skills: ['ENVI', 'UAV Mapping', 'Pix4DMapper', 'QGIS', 'Google Earth Engine', 'Spatial Analysis'],
          badge: 'badge-accent',
        },
        {
          title: 'Microsoft Office Suite',
          skills: ['Word', 'Excel', 'PowerPoint', 'Teams', 'Outlook', 'Power BI'],
          badge: 'badge-primary',
        },
        {
          title: 'Programming, Analysis and Visualization',
          skills: ['Python', 'SAS', 'Machine Learning', 'Computer Vision (YOLO)', 'Data Visualization'],
          badge: 'badge-info',
        },
      ].map((category, index) => (
        <div class="card bg-base-200 p-8 reveal" style={`transition-delay: ${(index + 1) * 150}ms;`}>
          <h2 class="mb-4 text-2xl font-bold">{category.title}</h2>
          <div class="flex flex-wrap gap-2">
            {category.skills.map(skill => (
              <div class={`badge ${category.badge} badge-lg p-4`}>{skill}</div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
